# PostgreSQL configuration (unified storage: corpus + vector + graph)
# Used by docker-compose.novel-db.yaml and script/import_pg_data.py
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=novel_graph_search
POSTGRES_USER=novel_admin
POSTGRES_PASSWORD=changeme_pgsql

# Embedding model configuration (used by script/import_pg_data.py for vector import)
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIM=2560
